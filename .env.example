# Public API URL for your Supabase instance, e.g. https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Use the publishable key when your Supabase version provides one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older self-hosted Supabase installations may provide an anon key instead.
# If used, leave NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=